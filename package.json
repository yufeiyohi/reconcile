{
  "name": "reconcile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:licenses && tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "VITE_APP_MODE=local VITE_BASE_PATH=/reconcile/ npm run build && playwright test",
    "format": "prettier --write src tests docs *.ts *.json *.html *.md .github/workflows/*.yml",
    "build:server": "tsc --noEmit -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.mjs",
    "start": "node server-dist/index.mjs",
    "db:migrate": "node server-dist/index.mjs --migrate",
    "password:hash": "node scripts/password-hash.mjs",
    "test:server": "vitest run --config vitest.server.config.ts",
    "build:licenses": "node scripts/third-party-notices.mjs",
    "admin:password": "node server-dist/index.mjs --reset-admin"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@thednp/dommatrix": "^3.1.2",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "fflate": "^0.8.2",
    "mysql2": "^3.24.6",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
