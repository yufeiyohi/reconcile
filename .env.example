# Only the Node backend reads these values. Never prefix credentials with VITE_.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Hermes: replace with the actual HTTPS website origin (no path).
APP_ORIGIN=https://reconcile.example.com
# One local Nginx reverse proxy. Keep backend bound to loopback.
TRUST_PROXY=1
DB_HOST=1.15.64.31
DB_PORT=3306
DB_DATABASE=reconcile
DB_USER=
DB_PASSWORD=
# Optional MySQL TLS certificate authority file; validation stays enabled.
DB_SSL_CA_FILE=
ADMIN_USERNAME=owner
# Preferred: generate with npm run password:hash. Quote the scrypt hash literally.
ADMIN_PASSWORD_HASH=
# Alternative only for first initialization; remove after db:migrate.
ADMIN_PASSWORD=
